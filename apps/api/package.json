{
  "name": "@delyva/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Delyva NestJS modular monolith.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/scripts/write-openapi.js",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "db:seed:catalog": "node --env-file-if-exists=.env dist/scripts/seed-catalog.js",
    "db:seed:pricing": "node --env-file-if-exists=.env dist/scripts/seed-pricing.js",
    "openapi": "node dist/scripts/write-openapi.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@delyva/contracts": "workspace:*",
    "@delyva/utils": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@delyva/config": "workspace:*",
    "@nestjs/testing": "12.5.1",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  }
}
