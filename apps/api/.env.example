# Local development only. Never commit a real .env. Production secrets come from AWS Secrets Manager/SSM.
NODE_ENV=development
PORT=3300
LOG_LEVEL=info
DATABASE_URL=postgres://delyva:delyva_local_only@127.0.0.1:55432/delyva
REDIS_URL=redis://127.0.0.1:56379/0
# Server-side pepper for hashing OTPs and phone lookups (>= 32 chars). Generate: openssl rand -hex 32
HASH_PEPPER=replace-with-a-random-64-hex-char-string-for-local-dev-only
# Ed25519 PKCS8 PEM, base64-encoded. Leave empty in development to generate an ephemeral key at boot.
JWT_PRIVATE_KEY_PEM_B64=
JWT_KEY_ID=dev-1
JWT_ISSUER=https://api.delyva.local
JWT_AUDIENCE=delyva-apps
# SMS provider: "termii" or "dev" (dev stores the latest OTP in Redis key dev:otp:<phone>, non-production only)
SMS_PROVIDER=dev
TERMII_API_KEY=
TERMII_SENDER_ID=Delyva
TERMII_BASE_URL=https://api.ng.termii.com
# ETA provider: "haversine" (offline heuristic) or "google" (Distance Matrix; needs GOOGLE_MAPS_API_KEY)
ETA_PROVIDER=haversine
GOOGLE_MAPS_API_KEY=

# Payments (ADR 0300). "fake" is a deterministic in-memory provider (non-production only).
PAYMENTS_PROVIDER=fake
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Comma-separated webhook source IPs (required in production; copy from Paystack's webhook docs).
PAYSTACK_WEBHOOK_IPS=
# HMAC secret used to sign/verify webhooks when PAYMENTS_PROVIDER=fake (dev only).
PAYMENTS_FAKE_WEBHOOK_SECRET=dev-fake-webhook-secret-change-me
PAYMENTS_CUSTOMER_EMAIL_DOMAIN=customers.delyva.invalid
PAYOUT_MIN_MINOR=100000
# Shared secret for workers -> /internal/payments/* job endpoints (>= 32 chars in production).
INTERNAL_JOBS_TOKEN=dev-internal-jobs-token-0123456789abcdef

# Onboarding & admin (ADR 0700)
# Public origin of this API (used by the local-disk storage adapter for signed upload URLs).
PUBLIC_API_URL=http://127.0.0.1:3300
# KYC provider: "fake" (deterministic, dev/test only) or "smile_id" (stub, not implemented yet).
KYC_PROVIDER=fake
# Storage: "local" (dev; files under STORAGE_LOCAL_DIR, served via signed /v1/uploads/content URLs) or "s3".
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/uploads
STORAGE_SIGNING_SECRET=
S3_BUCKET=
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_ENDPOINT=
# Field-level encryption keys "kid:base64(32 bytes),kid2:..." (empty in dev = key derived from HASH_PEPPER).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KID=dev
ADMIN_2FA_SESSION_TTL_SECONDS=43200
TOTP_ISSUER=Delyva
