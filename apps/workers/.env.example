# Local development only.
NODE_ENV=development
LOG_LEVEL=info
REDIS_URL=redis://127.0.0.1:56379/0
WORKER_CONCURRENCY=5
# Must match the API's BULLMQ_PREFIX.
BULLMQ_PREFIX=bull
# "expo" or "log" (log writes metadata only; production requires expo)
PUSH_PROVIDER=log
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
# "termii" or "log" (production requires termii)
SMS_PROVIDER=log
TERMII_API_KEY=
TERMII_SENDER_ID=Delyva
TERMII_BASE_URL=https://api.ng.termii.com
