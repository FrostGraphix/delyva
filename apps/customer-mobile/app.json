{
  "expo": {
    "name": "Delyva",
    "slug": "delyva-customer",
    "scheme": "delyva",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ng.delyva.customer"
    },
    "android": {
      "package": "ng.delyva.customer"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Delyva uses your location to show vendors that deliver to you and an honest delivery time."
        }
      ],
      "expo-notifications",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
